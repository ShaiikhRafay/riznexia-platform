{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true
  }
  // NOTE: outDir is deliberately NOT set here. TypeScript resolves relative
  // `extends`-inherited paths against the base config file's own directory,
  // not the consuming project's — so a shared "./dist" here would silently
  // build into packages/config-typescript/dist instead of the app's own
  // dist folder. Each consuming tsconfig.json must set its own outDir.
}
