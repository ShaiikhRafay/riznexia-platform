// Prisma schema — see docs/18-database-architecture.md for full original
// design rationale (relationships, cascade behavior, indexes, soft-delete
// pattern, audit log), and Module M2 (docs/21-implementation-roadmap.md,
// DECISIONS.md D-017+) for the Business/Lead split introduced here.
// Future/Post-MVP models are intentionally commented out at the bottom (§10).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

// Module M3 (DECISIONS.md D-023+) — six-role taxonomy, replacing the
// original three (ADMIN/MANAGER/SALES_REP). SUPER_ADMIN/ADMIN/SALES_MANAGER
// are seniority-ordered within the sales chain of command; DEVELOPER is a
// lateral technical-access role, not a rung on that same ladder; VIEWER is
// strictly read-only. The numeric hierarchy used for "at least this
// seniority" checks lives in code (apps/api/src/common/rbac/role-hierarchy.constants.ts),
// not here — Postgres enum ordinals are not relied on for authorization logic.
enum TeamRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  DEVELOPER
  SALES_EXECUTIVE
  VIEWER
}

enum WebsiteStatusType {
  NONE
  OUTDATED
  PRESENT
}

enum PipelineStage {
  NEW
  QUALIFIED
  CONTACTED
  IN_DISCUSSION
  WON
  LOST
}

enum WebsiteGenStatus {
  DRAFT
  GENERATING
  READY_FOR_REVIEW
  DEPLOYED
  FAILED
}

enum GenerationStage {
  ANALYSIS
  BRAND
  CONTENT
  IMAGE
  SEO
  BUILD
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Module M10 (DECISIONS.md D-085) — VIEWED/ACCEPTED/REJECTED added for
// proposal tracking. EDITED is no longer produced by any M10 code path
// (immutable version history — D-085 — means "editing" creates a new
// `SalesProposal` row/version rather than transitioning an existing one)
// but stays in the enum rather than being removed, since removing a
// database enum value the schema has ever shipped with is a real,
// disruptive migration for no functional benefit.
enum ProposalStatus {
  DRAFT
  EDITED
  SENT_MANUALLY
  VIEWED
  ACCEPTED
  REJECTED
}

// Module M10 — CrmTask.priority/.status.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DiscoveryJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Module M11 (DECISIONS.md D-093) — the Deployment Provider abstraction's
// closed set of pluggable targets. Only VERCEL has a concrete provider
// class this phase (`VercelProvider`); the rest are reserved values with
// no implementation yet, matching every other closed-enum-reservation in
// this codebase (e.g. `ProposalStatus.EDITED`) — a deliberate future
// extension point, not a silently-accepted new string.
enum DeploymentProviderName {
  VERCEL
  CLOUDFLARE_PAGES
  NETLIFY
  AWS_AMPLIFY
  AZURE_STATIC_WEB_APPS
  SELF_HOSTED
}

// Module M11 (DECISIONS.md D-093) — only `PRODUCTION` is creatable via the
// API this phase; `PREVIEW` is reserved for the founder's Future
// Compatibility "Preview Deployments" item.
enum DeploymentEnvironment {
  PRODUCTION
  PREVIEW
}

// Module M11 (DECISIONS.md D-094) — the deployment pipeline itself.
// Deliberately excludes a "rolled back" value: a rollback never mutates a
// historical row's status (same D-094 immutability decision), so nothing here ever needs to express
// "this deployment was superseded" — that fact lives on the *new* row's
// `rollbackFromDeploymentId` instead.
enum DeploymentStatus {
  REQUESTED
  VALIDATING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// Module M11 (DECISIONS.md D-095) — orthogonal to DeploymentStatus. A
// deployment can be COMPLETED with healthStatus still UNKNOWN (no health
// check has run yet) or UNHEALTHY (one ran and failed) — "Production
// Ready" is `status = COMPLETED && healthStatus = HEALTHY`, not its own
// enum value.
enum HealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

// Module M11 (DECISIONS.md D-096) — Domain Engine.
enum DomainType {
  CUSTOM
  SUBDOMAIN
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SslStatus {
  PENDING
  ACTIVE
  FAILED
  EXPIRED
}

// Module M4 (DECISIONS.md D-030+) — the rep-facing lead timeline's event
// vocabulary. Deliberately a DB enum, not a free-text string: unlike
// `AuditLog.action` (which spans every entity type in the system and must
// stay open-ended), this vocabulary is closed to what can actually happen
// to a Lead, so Postgres can reject a typo rather than silently storing an
// event type no UI knows how to render.
// Module M10 (DECISIONS.md D-086) — CALL/EMAIL/MEETING/WHATSAPP/
// WEBSITE_GENERATED/PREVIEW_SENT/PROPOSAL_SENT added. Reuses this same
// enum + model rather than a parallel CRM-specific activity system
// (founder's explicit Decision 5) — one unified, chronological timeline
// per lead, covering both system audit events (STAGE_CHANGED, ...) and
// rep-logged sales interactions (CALL, ...). `actorId` (already nullable)
// is the existing signal for which kind a given row is: null for
// system-generated (e.g. WEBSITE_GENERATED fired from the M8 pipeline),
// non-null for a rep manually logging a call/email/meeting/WhatsApp
// touch. The existing `detail: Json?` column carries type-specific
// metadata — no schema change needed there.
enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  ASSIGNED
  UNASSIGNED
  NOTE_ADDED
  TAGS_CHANGED
  DELETED
  CALL
  EMAIL
  MEETING
  WHATSAPP
  WEBSITE_GENERATED
  PREVIEW_SENT
  PROPOSAL_SENT
}

// Module M5 (DECISIONS.md D-033+) — the provider abstraction's DB-level
// counterpart. `LocationProvider`/`GooglePlacesProvider` (application code,
// apps/api/src/common/providers/) is deliberately provider-agnostic; this
// enum is what actually gets persisted once a provider produces data. Every
// future provider named in the M5 brief (Yelp/Facebook/Foursquare/CSV
// Import) is declared now even though only GOOGLE is implemented — cheap
// type safety, not built machinery (nothing else changes when one ships).
enum BusinessSourceProvider {
  GOOGLE
  YELP
  FACEBOOK
  FOURSQUARE
  CSV_IMPORT
}

// Module M5 — how `Business.websiteStatus` was last determined. GOOGLE_API
// covers the common case (Places' own `websiteUri` field settles it, no
// fetch needed); HEURISTIC_SCAN is Module M1's existing fetch+classify path
// (website-status.classifier.ts). AI_FALLBACK/MANUAL are reserved
// attachment points — the AI-assisted classification tier is still
// deferred (D-005), and no manual-edit feature exists yet.
enum WebsiteDetectionMethod {
  GOOGLE_API
  HEURISTIC_SCAN
  AI_FALLBACK
  MANUAL
}

// Module M5 — mirrors Google Places API (New)'s `businessStatus` field
// (Yelp/Facebook equivalents map onto the same three states).
enum BusinessOperatingStatus {
  OPERATIONAL
  CLOSED_TEMPORARILY
  CLOSED_PERMANENTLY
}

// Module M5 — PARTIAL exists because FR-parity with DiscoveryJobStatus
// isn't enough here: a sync run processes many businesses, and "some
// succeeded, some failed" (the per-business try/catch in
// PlaceSyncRunnerService) is a real, distinct outcome from a clean
// COMPLETED or a total FAILED (the search itself never returned).
enum PlaceSyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

// Module M6 (DECISIONS.md D-038+) — an analysis is PENDING while the AI
// call is in flight (fire-and-forget dispatch, same pattern as M1/M5),
// COMPLETED once a validated brandBrief is persisted, or FAILED once the
// repair-retry ladder (Doc 21 M6 entry, Req 5) is exhausted without a
// schema-valid response. There is no PARTIAL here — a single AI call
// either produces a valid structured brief or it doesn't; unlike
// PlaceSyncJob there is no per-candidate batch to be partially successful
// over.
enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

// Module M6 — the AI provider abstraction's DB-level counterpart, mirroring
// BusinessSourceProvider's (D-033) forward-declaration rationale: every
// provider named in the M6 brief (Claude/OpenAI/Gemini/DeepSeek/Local LLM)
// is declared now even though only CLAUDE is implemented (AnthropicProvider,
// apps/api's AI_TEXT_PROVIDER binding) — cheap type safety, not built
// machinery.
enum AiProviderName {
  CLAUDE
  OPENAI
  GEMINI
  DEEPSEEK
  LOCAL_LLM
}

// Module M7 (DECISIONS.md D-044+) — the Theme Engine's structural output
// enums. These are purely presentational/structural choices owned by the
// selected theme (packages/themes) — never the brand-identity fields M6
// owns (colorPalette/typography/layoutStyle/etc., which flow through
// unchanged from BusinessAnalysis.brandBrief).
enum NavigationStyle {
  TOP_BAR
  TOP_BAR_STICKY
  SIDEBAR
  MINIMAL_HAMBURGER
}

enum HeroStyle {
  FULL_BLEED_IMAGE
  SPLIT_IMAGE_TEXT
  VIDEO_BACKGROUND
  CAROUSEL
  MINIMAL_TEXT
}

enum CtaStyle {
  SOLID_BUTTON
  OUTLINE_BUTTON
  FLOATING_ACTION
  BANNER_STRIP
}

enum CardStyle {
  ELEVATED_SHADOW
  FLAT_BORDERED
  MINIMAL_DIVIDER
  IMAGE_OVERLAY
}

enum FooterStyle {
  MULTI_COLUMN
  SIMPLE_CENTERED
  NEWSLETTER_CTA
}

enum AnimationLevel {
  NONE
  SUBTLE
  MODERATE
  EXPRESSIVE
}

enum ImageStyle {
  PHOTOGRAPHY_REALISTIC
  ILLUSTRATION
  ICON_DRIVEN
  MINIMAL_GRAPHIC
}

// ---------- Active Models ----------

// Module M3: this is a single-organization employee directory today — every
// row implicitly belongs to Riznexia's one internal workspace. An
// `organizationId` FK would attach here if/when multi-org support is ever
// built; see the commented-out `Organization` model in the FUTURE section
// below. Not added as a real column now (nothing consumes it) — kept as a
// documented attachment point, not spec'd-ahead-of-need schema.
model TeamMember {
  id          String    @id @default(uuid())
  clerkUserId String    @unique @map("clerk_user_id")
  name        String
  email       String    @unique
  role        TeamRole  @default(SALES_EXECUTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  discoveryJobs  DiscoveryJob[]
  assignedLeads  Lead[]         @relation("AssignedLeads")
  auditLogs      AuditLog[]
  authoredNotes  LeadNote[]     @relation("AuthoredNotes")
  leadActivities LeadActivity[] @relation("LeadActivities")
  placeSyncJobs  PlaceSyncJob[]

  // Module M10 — CRM bounded context. `ownedLeadCrms` is deliberately a
  // distinct relation from `assignedLeads` above (D-083): the CRM's own
  // "deal owner" concept on `LeadCRM.ownerId`, independent of the M4
  // `Lead.assignedToId` this same TeamMember may also hold.
  ownedLeadCrms     LeadCRM[]       @relation("CrmLeadOwner")
  assignedCrmTasks  CrmTask[]       @relation("AssignedCrmTasks")
  completedCrmTasks CrmTask[]       @relation("CompletedCrmTasks")
  createdCrmTasks   CrmTask[]       @relation("CreatedCrmTasks")
  createdProposals  SalesProposal[] @relation("CreatedProposals")

  // Module M11 — "Created By" on WebsiteDeployment (founder's explicit
  // per-deployment field requirement).
  createdWebsiteDeployments WebsiteDeployment[] @relation("CreatedWebsiteDeployments")

  // Module M12 — the actor behind a captured AnalyticsEvent, when known.
  analyticsEvents AnalyticsEvent[]

  @@index([deletedAt])
  @@map("team_members")
}

model DiscoveryJob {
  id           String             @id @default(uuid())
  createdById  String?            @map("created_by")
  createdBy    TeamMember?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  city         String
  category     String
  status       DiscoveryJobStatus @default(QUEUED)
  resultsCount Int                @default(0) @map("results_count")
  createdAt    DateTime           @default(now()) @map("created_at")

  // Doc 22 §5/§6 (M1) — a discovery run finds Businesses; only a subset of
  // those (none/outdated) go on to get a Lead (M2 §Business split below).
  businesses Business[]

  @@index([createdById])
  @@map("discovery_jobs")
}

// Module M2 addition: the "what" — a real-world business and everything we
// know about its web presence, independent of whether Riznexia is actively
// pursuing it. Previously these fields lived directly on Lead; splitting
// them out means a discovered business that turns out to already have a
// good website (`PRESENT`) is still recorded (for FR-1.7 refresh semantics
// and future dedupe) without implying a sales pursuit exists for it.
model Business {
  id            String            @id @default(uuid())
  googlePlaceId String            @unique @map("google_place_id")
  businessName  String            @map("business_name")
  category      String
  city          String
  address       String
  placesData    Json              @map("places_data")
  websiteStatus WebsiteStatusType @default(NONE) @map("website_status")

  // Module M5 (DECISIONS.md D-033+) — promoted from inside the opaque
  // `placesData` blob to real typed columns (AskUserQuestion resolution
  // during M5 planning): queryable/filterable, and each provider's
  // adapter maps its own response shape onto these same fields rather than
  // downstream code reaching into provider-specific JSON.
  latitude       Decimal?                @db.Decimal(9, 6)
  longitude      Decimal?                @db.Decimal(9, 6)
  phone          String?
  rating         Float?
  reviewCount    Int?                    @map("review_count")
  openingHours   Json?                   @map("opening_hours")
  photos         Json?
  businessStatus BusinessOperatingStatus @default(OPERATIONAL) @map("business_status")

  // Module M5 — requested addition. `googleBusinessUrl` is deliberately
  // named provider-specifically here (unlike the `LocationDetails.profileUrl`
  // field in the provider-agnostic interface layer, apps/api/src/common/
  // providers/) because this is the literal DB column the founder asked
  // for; the interface-to-column mapping happens once, at the sync write
  // path (PlaceSyncRunnerService/DiscoveryRunnerService).
  googleBusinessUrl      String?                 @map("google_business_url")
  // Stamped whenever websiteStatus is (re)determined — distinct from
  // `updatedAt` (which moves on any field change) and useful because
  // website checks are cached on a different TTL than general sync.
  websiteDetectedAt      DateTime?               @map("website_detected_at")
  websiteDetectionMethod WebsiteDetectionMethod? @map("website_detection_method")
  // Starts at 1 on create, atomically incremented on every subsequent sync
  // write (BusinessService.upsertByPlaceId) — lightweight change tracking,
  // not used for optimistic-concurrency control today.
  syncVersion            Int                     @default(1) @map("sync_version")
  sourceProvider         BusinessSourceProvider  @default(GOOGLE) @map("source_provider")
  lastSyncedAt           DateTime?               @map("last_synced_at")
  lastSyncJobId          String?                 @map("last_sync_job_id")
  lastSyncJob            PlaceSyncJob?           @relation(fields: [lastSyncJobId], references: [id], onDelete: SetNull)

  discoveryJobId String?       @map("discovery_job_id")
  discoveryJob   DiscoveryJob? @relation(fields: [discoveryJobId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  // A Business has at most one Lead — created once, the first time it
  // qualifies (none/outdated); see BusinessService/LeadsService for the
  // exact upsert-then-conditionally-create flow this enforces.
  lead                    Lead?
  businessAnalyses        BusinessAnalysis[]
  themeConfigurations     ThemeConfiguration[]
  layoutConfigurations    LayoutConfiguration[]
  componentManifests      ComponentManifest[]
  contentManifests        ContentManifest[]
  generatedWebsites       GeneratedWebsite[]
  websitePreviews         WebsitePreview[]
  previewReports          PreviewReport[]
  publishReadinessReports PublishReadinessReport[]
  // Module M11 (DECISIONS.md D-092) — FK'd here, not to the legacy
  // `Website` model.
  websiteDeployments      WebsiteDeployment[]
  domains                 Domain[]

  @@index([deletedAt])
  @@index([city])
  @@index([category])
  @@index([discoveryJobId])
  @@index([lastSyncJobId])
  // Plain btree — helps exact-match/prefix lookups and sorting, not the
  // `contains`/ILIKE wildcard search GET /leads?q= actually runs (Doc 19
  // §5). A trigram GIN index would serve that better; deliberately not
  // added without a live database to verify the syntax against (Doc 22
  // audit finding #7, DECISIONS.md D-015).
  @@index([businessName])
  @@map("businesses")
}

// Module M5 — a background Google Places (or future-provider) sync run.
// Deliberately its own model, not a reuse/extension of M1's `DiscoveryJob`:
// keeps M1's frozen model untouched and avoids scope bleed between two
// independently-versioned modules, even though both models look similar.
model PlaceSyncJob {
  id          String                 @id @default(uuid())
  createdById String?                @map("created_by")
  createdBy   TeamMember?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  provider    BusinessSourceProvider @default(GOOGLE)

  // Search params this run was started with — one of city/category or
  // latitude+longitude+radius is expected, matching LocationProvider's
  // `search()` contract (apps/api/src/common/providers/location-provider.interface.ts).
  city         String?
  category     String?
  keyword      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  radiusMeters Int?     @map("radius_meters")

  status PlaceSyncJobStatus @default(QUEUED)

  // Module M5 — requested addition. `startedAt`/`finishedAt` mark the
  // actual processing window (distinct from `createdAt`, which is queue
  // time). `duration` (seconds) and `successRate` are written once, at
  // completion, rather than recomputed on every read.
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  duration      Int?      @map("duration_seconds")
  successRate   Float?    @map("success_rate")
  apiCallsUsed  Int       @default(0) @map("api_calls_used")
  // Decimal(10,4), matching CostEvent.costUsd — not Float, to avoid
  // rounding drift on money.
  estimatedCost Decimal   @default(0) @map("estimated_cost") @db.Decimal(10, 4)

  businessesFound   Int @default(0) @map("businesses_found")
  businessesCreated Int @default(0) @map("businesses_created")
  businessesUpdated Int @default(0) @map("businesses_updated")
  businessesFailed  Int @default(0) @map("businesses_failed")

  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  businesses Business[]

  @@index([createdById])
  @@index([status])
  @@map("place_sync_jobs")
}

// The "so what" — Riznexia's own pursuit of a Business. Pure pipeline
// state: no business-data fields live here anymore (Module M2). Doc 19's
// public `GET /leads` response shape is unchanged — it's now assembled by
// joining Business, not read directly off this table.
model Lead {
  id            String        @id @default(uuid())
  businessId    String        @unique @map("business_id")
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pipelineStage PipelineStage @default(NEW) @map("pipeline_stage")
  assignedToId  String?       @map("assigned_to")
  assignedTo    TeamMember?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Module M4 (DECISIONS.md D-031): free-form labels as a Postgres text
  // array rather than a normalized Tag/LeadTag pair. Covers everything M4
  // requires — add, remove, filter-by-tag, list-distinct — in one column.
  // Tag *governance* (rename, merge, colour) would want the normalized
  // shape; that's not a current requirement, and this project's precedent
  // is to build what's needed and document the attachment point (D-027).
  tags          String[]      @default([])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  websites   Website[]
  proposals  SalesProposal[]
  // Module M4: `notes` was a single overwritable String column through M3.
  // It's now an append-only, authored collection (LeadNote) — "add a note"
  // is genuinely additive, and a CRM note without an author or timestamp
  // can't support the timeline this module exists to feed (D-030).
  leadNotes  LeadNote[]
  activities LeadActivity[]

  // Module M10 (DECISIONS.md D-083) — deliberately NOT new columns on
  // `Lead` itself. `Lead` stays the discovery/business record exactly as
  // M2/M4 defined it (including its own `pipelineStage` above, untouched);
  // every CRM-specific field (stage, deal value, lost reason, owner,
  // follow-up metadata) lives on the separate `LeadCRM` side-table this
  // relation points to, keeping the two bounded contexts genuinely
  // separated rather than nominally separated with shared columns.
  leadCrm  LeadCRM?
  crmTasks CrmTask[]

  @@index([pipelineStage])
  @@index([assignedToId])
  @@index([deletedAt])
  // GIN — the right index type for `tags @> ARRAY[...]` containment, which
  // is what the `?tag=` filter compiles to. Unlike the businessName search
  // (D-015, where the correct index needed unverifiable pg_trgm syntax),
  // this one is generated by Prisma itself rather than hand-written, so the
  // SQL is verified by `prisma migrate diff` rather than guessed at.
  @@index([tags], type: Gin)
  @@map("leads")
}

// Module M4 (DECISIONS.md D-030). Append-only: there is no update or delete
// path in application code. Editing history away would defeat the point of
// an internal record of what a rep was told and when.
model LeadNote {
  id        String      @id @default(uuid())
  leadId    String      @map("lead_id")
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Nullable + SET NULL for the same reason AuditLog.actor is: a note's
  // content stays meaningful after its author is offboarded.
  authorId  String?     @map("author_id")
  author    TeamMember? @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

// Module M4 (DECISIONS.md D-032). The rep-facing timeline — deliberately
// separate from `audit_log`, which is the security/accountability trail.
// Different consumers (a sales rep vs. an admin investigating), different
// content (no IP addresses here), different vocabulary (closed enum vs.
// open action string). Both are written for a user-initiated write; only
// this one is written for a pipeline-initiated write (discovery creating a
// lead has no human actor to audit).
model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String           @map("lead_id")
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?          @map("actor_id")
  actor     TeamMember?      @relation("LeadActivities", fields: [actorId], references: [id], onDelete: SetNull)
  type      LeadActivityType
  // Before/after values where relevant, e.g. { "from": "new", "to": "qualified" }.
  detail    Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// Module M10 (DECISIONS.md D-084) — the Pipeline Engine's configurable
// stage list, replacing a hardcoded enum specifically for the CRM's own
// pipeline (the pre-existing `Lead.pipelineStage`/`PipelineStage` enum
// from M4 is untouched — see D-083). Seeded with 10 default stages by
// this model's own migration; addable/renameable/reorderable via the API
// from there. Archived, never hard-deleted (founder's Decision 10) — a
// `LeadCRM` row referencing an archived stage keeps working, it's simply
// no longer offered for new selection.
model SalesStage {
  id         String    @id @default(uuid())
  key        String    @unique
  name       String
  order      Int       @unique
  isWon      Boolean   @default(false) @map("is_won")
  isLost     Boolean   @default(false) @map("is_lost")
  color      String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  leadCrms    LeadCRM[]
  crmSettings CrmSettings[]

  @@index([archivedAt])
  @@map("sales_stages")
}

// Module M10 (DECISIONS.md D-084) — configurable lost-reason list
// (founder's Decision 11: "Use a LostReason table instead of a fixed
// enum"), same shape/archive discipline as `SalesStage` above.
model LostReason {
  id         String    @id @default(uuid())
  key        String    @unique
  label      String
  order      Int       @unique
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  leadCrms LeadCRM[]

  @@index([archivedAt])
  @@map("lost_reasons")
}

// Module M10 (DECISIONS.md D-083) — the CRM bounded context's own
// per-lead record, one-to-one with `Lead`. Everything the founder's
// Decision 3 named ("stage, deal value, lost reason, owner, follow-up
// metadata") lives here, not on `Lead` itself. Rows are created lazily
// (get-or-create — `LeadCrmService.getOrCreate()`) the first time any CRM
// engine touches a given lead, rather than `LeadsService` (M4) knowing
// anything about the CRM module — keeps the dependency direction one-way
// (crm/ depends on leads/, never the reverse).
model LeadCRM {
  id     String @id @default(uuid())
  leadId String @unique @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  stageId String     @map("stage_id")
  stage   SalesStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  dealValueUsd Decimal? @map("deal_value_usd") @db.Decimal(12, 2)

  lostReasonId String?     @map("lost_reason_id")
  lostReason   LostReason? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  // The CRM's own "deal owner" — deliberately independent of
  // `Lead.assignedToId` (D-083). Nullable: a lead isn't necessarily
  // claimed by a rep in the CRM sense the moment its `LeadCRM` row is
  // lazily created.
  ownerId String?     @map("owner_id")
  owner   TeamMember? @relation("CrmLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Follow-up metadata (founder's Decision 3) — `nextFollowUpAt` is a
  // plain, directly-settable field; nothing dispatches a reminder for it
  // (no notification channel exists yet — email/WhatsApp sending are
  // explicitly out of scope this module). `lastActivityAt` is a cheap
  // denormalized pointer to this lead's most recent interaction-type
  // `LeadActivity` row, maintained by the Activity Engine, so Reporting/
  // stale-lead queries never need an expensive correlated subquery.
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  lastActivityAt DateTime? @map("last_activity_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stageId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@map("lead_crms")
}

// Module M10 — Task Engine. "Follow-ups" and "Reminders" (founder's Core
// Features list) are deliberately not separate entities — a follow-up is
// just a `CrmTask` (e.g. title: "Follow up with X"), and `reminderAt` is
// a stored scheduling field, not a delivery mechanism (nothing sends a
// notification for it this module — see the constraint against email/
// WhatsApp sending). `estimatedDurationMinutes`/`actualDurationMinutes`/
// `completedById` per the founder's explicit Decision 4.
model CrmTask {
  id     String @id @default(uuid())
  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime     @map("due_date")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)

  assignedToId String?     @map("assigned_to")
  assignedTo   TeamMember? @relation("AssignedCrmTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  reminderAt DateTime? @map("reminder_at")

  estimatedDurationMinutes Int? @map("estimated_duration_minutes")
  actualDurationMinutes    Int? @map("actual_duration_minutes")

  completedById String?     @map("completed_by")
  completedBy   TeamMember? @relation("CompletedCrmTasks", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?   @map("completed_at")

  createdById String?     @map("created_by")
  createdBy   TeamMember? @relation("CreatedCrmTasks", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([assignedToId, status])
  @@index([dueDate])
  @@map("crm_tasks")
}

// Module M10 (DECISIONS.md D-087) — founder's explicit Decision 12.
// Single-organization system (same "no multi-org support" scope as
// `TeamMember`'s own doc comment) — a genuine singleton, seeded with
// exactly one row by this model's own migration and only ever read/
// updated by id from there, never created a second time.
model CrmSettings {
  id String @id @default(uuid())

  defaultStageId String?     @map("default_stage_id")
  defaultStage   SalesStage? @relation(fields: [defaultStageId], references: [id], onDelete: SetNull)

  currency                        String @default("USD")
  timezone                        String @default("UTC")
  businessHours                   Json?  @map("business_hours")
  defaultReminderMinutesBeforeDue Int?   @map("default_reminder_minutes_before_due")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_settings")
}

// Module M6 (DECISIONS.md D-037+) — AI Business Analyzer output. Every
// analysis is a new, immutable row (analysisVersion increments per
// businessId, never overwritten) — historical analyses are kept, matching
// the founder's explicit "never overwrite" requirement. `brandBrief` still
// holds the 19-field structured output as Json (D-038: not promoted to
// typed columns — the whole value is read together, unlike Business's
// Google Places fields, which are filtered/sorted on individually).
// `confidenceScore` is the one output field promoted to a typed column,
// specifically so a future "show me low-confidence analyses" query doesn't
// need to parse JSON.
model BusinessAnalysis {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Historical versioning (Req 3) — starts at 1 per business, never reused;
  // enforced by the unique constraint below rather than left to caller
  // discipline.
  analysisVersion Int @default(1) @map("analysis_version")

  // Prompt versioning (Req 1) — every analysis records exactly which
  // template produced it. promptHash is a SHA-256 of the rendered template
  // strings, committed alongside the template module
  // (packages/ai/src/prompt/business-analysis/) and asserted by a test —
  // any undocumented template edit fails that test.
  promptName    String @map("prompt_name")
  promptVersion String @map("prompt_version")
  promptHash    String @map("prompt_hash")

  aiProvider AiProviderName @map("ai_provider")
  aiModel    String         @map("ai_model")

  // AI result cache (Req 2) — SHA-256 of the business fingerprint fields
  // (name/category/rating/reviewCount/website/phone/address/photos +
  // Business.syncVersion) at the time this analysis ran. A cache lookup
  // compares the *current* business's freshly computed hash against the
  // latest COMPLETED row's inputHash for the same business; a match means
  // "nothing changed since this analysis ran" and the AI provider is never
  // called (BusinessAnalysisService.findOrCreate).
  inputHash String @map("input_hash")

  status AnalysisStatus @default(PENDING)

  // Populated only once status is COMPLETED — the 19-field structured
  // output (packages/shared-types businessAnalysisOutputSchema). Stays
  // null while PENDING/FAILED; AI Safety requirement (Req 5): invalid
  // structured data is never persisted here.
  brandBrief       Json?  @map("brand_brief")
  sentimentSummary Json?  @map("sentiment_summary")
  confidenceScore  Float? @map("confidence_score")

  // AI Safety (Req 5) — populated only on FAILED, after the repair-prompt
  // retry ladder is exhausted: the raw model text and the Zod validation
  // errors, so a prompt-quality regression is diagnosable rather than
  // silently swallowed. rawResponse is truncated to 64KB at the write
  // boundary (BusinessAnalyzerRunnerService) to bound storage.
  rawResponse      String? @map("raw_response")
  validationErrors Json?   @map("validation_errors")

  executionTimeMs Int?      @map("execution_time_ms")
  completedAt     DateTime? @map("completed_at")

  // Cost tracking (Req 6) — every attempt's tokens are summed across the
  // full run (initial call + any transient retries + one repair attempt),
  // not just the final successful call.
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  estimatedCost    Decimal? @map("estimated_cost") @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at")

  themeConfigurations  ThemeConfiguration[]
  layoutConfigurations LayoutConfiguration[]
  componentManifests   ComponentManifest[]
  contentManifests     ContentManifest[]
  generatedWebsites    GeneratedWebsite[]

  // One row per (business, version) — analysisVersion is computed inside a
  // transaction as MAX(analysisVersion WHERE businessId) + 1; this
  // constraint is the concurrency backstop, not the primary allocation
  // mechanism.
  @@unique([businessId, analysisVersion])
  @@index([businessId, createdAt])
  // Cache lookup path (BusinessAnalysisService.findOrCreate): find the
  // latest COMPLETED row for a businessId and compare inputHash, without a
  // full table scan.
  @@index([businessId, inputHash, status])
  @@map("business_analyses")
}

// Module M7 (DECISIONS.md D-044+) — Theme Engine output. "Themes must
// adapt to the brand; the brand must never adapt to the theme" (founder's
// explicit rule, D-045): the brand-identity fields below (industry,
// layoutStyle, colorPalette, typography) are copied verbatim from the
// `businessAnalysis` this row is derived from — this model never
// regenerates or overrides them. Everything else here is the selected
// theme's own structural output. Versioned like `BusinessAnalysis` — a new
// `businessAnalysisId` (e.g. after a re-analysis) produces a new,
// traceable `ThemeConfiguration` row, never an overwrite of the old one.
model ThemeConfiguration {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessAnalysisId String           @map("business_analysis_id")
  businessAnalysis   BusinessAnalysis @relation(fields: [businessAnalysisId], references: [id], onDelete: Cascade)

  // Historical versioning, same pattern as BusinessAnalysis.analysisVersion
  // — never overwritten; enforced by the unique constraint below.
  configVersion Int @default(1) @map("config_version")

  // Theme versioning (founder's explicit requirement) — the exact
  // ThemeDefinition (packages/themes) this configuration was assembled
  // from, so a website generated today stays reproducible even after the
  // theme definition itself is later edited.
  themeId      String @map("theme_id")
  themeName    String @map("theme_name")
  themeVersion String @map("theme_version")
  themeHash    String @map("theme_hash")

  selectedAt              DateTime @default(now()) @map("selected_at")
  // The Theme SELECTION ENGINE's own version (rules + scoring logic) —
  // distinct from themeVersion (which versions the chosen theme's
  // content). Lets a later rule-engine change be distinguished from a
  // theme-content change in the audit trail.
  selectedByEngineVersion String   @map("selected_by_engine_version")
  compatibilityScore      Float    @map("compatibility_score")

  // ---------- Brand-identity fields — copied verbatim from
  // businessAnalysis.brandBrief, never regenerated (founder's explicit
  // "brand must never adapt to the theme" rule). ----------
  industry     String
  layoutStyle  String @map("layout_style")
  colorPalette Json   @map("color_palette")
  typography   Json

  // ---------- Theme-owned structural fields — from the selected
  // ThemeDefinition, informed by (but not copied from) BusinessAnalysis's
  // websiteSections via the compatibility check. ----------
  componentSet         Json            @map("component_set")
  navigationStyle      NavigationStyle @map("navigation_style")
  heroStyle            HeroStyle       @map("hero_style")
  ctaStyle             CtaStyle        @map("cta_style")
  cardStyle            CardStyle       @map("card_style")
  footerStyle          FooterStyle     @map("footer_style")
  animationLevel       AnimationLevel  @map("animation_level")
  imageStyle           ImageStyle      @map("image_style")
  sectionOrder         Json            @map("section_order")
  accessibilityProfile Json            @map("accessibility_profile")
  mobilePreferences    Json            @map("mobile_preferences")

  // Module M8.1 (DECISIONS.md D-049) — explicit componentSet-to-sectionOrder
  // binding, copied verbatim from the selected ThemeDefinition's own
  // sectionComponentMap. Added because the Layout Generator needs this
  // link and componentSet/sectionOrder were previously two independent
  // flat lists with no explicit connection between them. Amended directly
  // into this not-yet-shipped M7 migration (same rationale as D-048's
  // ai_recommendation_* columns) rather than a separate migration.
  sectionComponentMap Json @map("section_component_map")

  // Founder's explicit ranking requirement — every theme that cleared the
  // minimum compatibility score, sorted descending. rankedThemes[0] is
  // this row's own selection (themeId/themeName/themeVersion/
  // compatibilityScore above are that entry, denormalized for query
  // convenience); the rest are the stored alternatives for a future
  // manual-override feature (not built — D-045's forward-compatibility
  // note).
  rankedThemes Json @map("ranked_themes")

  // Module M7 follow-up (DECISIONS.md D-048) — CostService integration for
  // the "AI recommends" step (D-046). All nullable: the AI recommendation
  // is best-effort (D-046's resilience guarantee is unchanged by this
  // addition) — these stay null when the step was skipped (quota reached)
  // or failed (provider/transient error), exactly like BusinessAnalysis's
  // own aiProvider/aiModel/token/cost columns stay unset until a real call
  // actually completes.
  aiRecommendationProvider         AiProviderName? @map("ai_recommendation_provider")
  aiRecommendationModel            String?         @map("ai_recommendation_model")
  aiRecommendationPromptTokens     Int?            @map("ai_recommendation_prompt_tokens")
  aiRecommendationCompletionTokens Int?            @map("ai_recommendation_completion_tokens")
  aiRecommendationTotalTokens      Int?            @map("ai_recommendation_total_tokens")
  aiRecommendationCostUsd          Decimal?        @map("ai_recommendation_cost_usd") @db.Decimal(10, 4)
  aiRecommendationExecutionTimeMs  Int?            @map("ai_recommendation_execution_time_ms")

  createdAt DateTime @default(now()) @map("created_at")

  layoutConfigurations LayoutConfiguration[]
  componentManifests   ComponentManifest[]
  contentManifests     ContentManifest[]
  generatedWebsites    GeneratedWebsite[]

  @@unique([businessId, configVersion])
  @@index([businessId, createdAt])
  @@index([businessAnalysisId])
  @@map("theme_configurations")
}

// Module M8.1 (DECISIONS.md D-050+) — Layout Generator output. Deterministic:
// given the same BusinessAnalysis and ThemeConfiguration, generateLayout()
// (packages/website-generator) always produces the same LayoutConfiguration
// — no AI call, no randomness. Versioned per business like
// BusinessAnalysis/ThemeConfiguration (never overwritten); FK'd to both of
// its inputs for full provenance. Every compound structure (pageStructure,
// navigation, hero, footer, grid, responsiveRules, ctaPlacements,
// componentPlaceholders) is stored as Json, same "the whole value is read
// together" reasoning as ThemeConfiguration's colorPalette/typography
// (D-038) — nothing here is queried by an individual sub-field.
model LayoutConfiguration {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessAnalysisId String           @map("business_analysis_id")
  businessAnalysis   BusinessAnalysis @relation(fields: [businessAnalysisId], references: [id], onDelete: Cascade)

  themeConfigurationId String             @map("theme_configuration_id")
  themeConfiguration   ThemeConfiguration @relation(fields: [themeConfigurationId], references: [id], onDelete: Cascade)

  // Historical versioning, same pattern as BusinessAnalysis.analysisVersion/
  // ThemeConfiguration.configVersion — never overwritten; enforced by the
  // unique constraint below.
  configVersion Int @default(1) @map("config_version")

  // The Layout Generator's own version (derivation rules), distinct from
  // themeVersion/selectedByEngineVersion — versions this module's algorithm,
  // not its inputs.
  layoutEngineVersion String @map("layout_engine_version")

  pageStructure         Json  @map("page_structure")
  navigation            Json
  hero                  Json
  footer                Json
  // Null unless the source ThemeConfiguration's navigationStyle is
  // 'sidebar' — none of the 8 M7 themes use it today, but the shape is
  // forward-compatible.
  sidebar               Json?
  grid                  Json
  responsiveRules       Json  @map("responsive_rules")
  ctaPlacements         Json  @map("cta_placements")
  componentPlaceholders Json  @map("component_placeholders")

  createdAt DateTime @default(now()) @map("created_at")

  componentManifests ComponentManifest[]
  contentManifests   ContentManifest[]
  generatedWebsites  GeneratedWebsite[]

  @@unique([businessId, configVersion])
  @@index([businessId, createdAt])
  @@index([themeConfigurationId])
  @@map("layout_configurations")
}

// Module M8.2 (DECISIONS.md D-055+) — Component Generator output.
// Deterministic: given the same BusinessAnalysis, ThemeConfiguration, and
// LayoutConfiguration, generateComponentManifest() (packages/website-generator)
// always produces the same ComponentManifest — no AI call, no randomness.
// Versioned per business like every prior M6-M8 output (never overwritten);
// FK'd to all three inputs for full provenance. `themeTokens` and
// `components` are Json — same "the whole value is read together"
// reasoning as every other compound-structure column in this schema
// (ThemeConfiguration.colorPalette, LayoutConfiguration.pageStructure).
model ComponentManifest {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessAnalysisId String           @map("business_analysis_id")
  businessAnalysis   BusinessAnalysis @relation(fields: [businessAnalysisId], references: [id], onDelete: Cascade)

  themeConfigurationId String             @map("theme_configuration_id")
  themeConfiguration   ThemeConfiguration @relation(fields: [themeConfigurationId], references: [id], onDelete: Cascade)

  layoutConfigurationId String              @map("layout_configuration_id")
  layoutConfiguration   LayoutConfiguration @relation(fields: [layoutConfigurationId], references: [id], onDelete: Cascade)

  // Historical versioning, same pattern as every prior M6-M8 output —
  // never overwritten; enforced by the unique constraint below.
  configVersion Int @default(1) @map("config_version")

  // The Component Generator's own version (derivation rules), distinct
  // from layoutEngineVersion/themeVersion/selectedByEngineVersion —
  // versions this module's algorithm, not its inputs.
  componentEngineVersion String @map("component_engine_version")

  themeTokens Json @map("theme_tokens")
  components  Json

  createdAt DateTime @default(now()) @map("created_at")

  contentManifests  ContentManifest[]
  generatedWebsites GeneratedWebsite[]

  @@unique([businessId, configVersion])
  @@index([businessId, createdAt])
  @@index([layoutConfigurationId])
  @@map("component_manifests")
}

// Module M8.3 (DECISIONS.md D-061+) — Content Binding output. Deterministic:
// given the same BusinessAnalysis, ThemeConfiguration, LayoutConfiguration,
// and ComponentManifest, generateContentManifest() (packages/website-generator)
// always produces the same ContentManifest — no AI call, no prompt
// execution, no content regeneration. Versioned per business like every
// prior M6-M8 output (never overwritten); FK'd to all four upstream
// artifacts for full provenance. `componentContent`/`unresolvedBindings`/
// `seoMetadata`/`structuredData` are Json — same "the whole value is read
// together" reasoning as every other compound-structure column in this
// schema; every value inside carries its own `source` string
// (founder's explicit "traceable to origin" requirement), enforced at the
// application layer (Zod), not by a DB constraint.
model ContentManifest {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessAnalysisId String           @map("business_analysis_id")
  businessAnalysis   BusinessAnalysis @relation(fields: [businessAnalysisId], references: [id], onDelete: Cascade)

  themeConfigurationId String             @map("theme_configuration_id")
  themeConfiguration   ThemeConfiguration @relation(fields: [themeConfigurationId], references: [id], onDelete: Cascade)

  layoutConfigurationId String              @map("layout_configuration_id")
  layoutConfiguration   LayoutConfiguration @relation(fields: [layoutConfigurationId], references: [id], onDelete: Cascade)

  componentManifestId String            @map("component_manifest_id")
  componentManifest   ComponentManifest @relation(fields: [componentManifestId], references: [id], onDelete: Cascade)

  // Historical versioning, same pattern as every prior M6-M8 output —
  // never overwritten; enforced by the unique constraint below.
  configVersion Int @default(1) @map("config_version")

  // The Content Binder's own version (binding rules), distinct from
  // componentEngineVersion/layoutEngineVersion/themeVersion — versions
  // this module's algorithm, not its four inputs.
  contentEngineVersion String @map("content_engine_version")

  componentContent   Json @map("component_content")
  unresolvedBindings Json @map("unresolved_bindings")
  seoMetadata        Json @map("seo_metadata")
  structuredData     Json @map("structured_data")

  createdAt DateTime @default(now()) @map("created_at")

  generatedWebsites GeneratedWebsite[]

  @@unique([businessId, configVersion])
  @@index([businessId, createdAt])
  @@index([componentManifestId])
  @@map("content_manifests")
}

// Module M8.4 (DECISIONS.md D-068+) — Website Assembly output. Deterministic:
// given the same ThemeConfiguration, LayoutConfiguration, ComponentManifest,
// and ContentManifest, assembleWebsite() (packages/website-generator)
// always produces the same file list — no AI call, no randomness, no
// regeneration of any upstream layout/component/content decision, only
// assembly. FK'd to all five upstream M6-M8.3 artifacts for full
// provenance, same discipline as every other M8.x output, even though the
// generator function itself only reads four of them directly (businessName
// and every other BusinessAnalysis-derived fact were already carried
// through into ComponentManifest/ContentManifest by the time this phase
// runs). `files` is the entire generated Next.js project as a flat
// {path, content}[] array — same "the whole value is read/written
// together" reasoning as every other compound Json column in this schema;
// there is no separate object-storage/S3 infrastructure anywhere in this
// stack, so the project's full source lives here.
model GeneratedWebsite {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessAnalysisId String           @map("business_analysis_id")
  businessAnalysis   BusinessAnalysis @relation(fields: [businessAnalysisId], references: [id], onDelete: Cascade)

  themeConfigurationId String             @map("theme_configuration_id")
  themeConfiguration   ThemeConfiguration @relation(fields: [themeConfigurationId], references: [id], onDelete: Cascade)

  layoutConfigurationId String              @map("layout_configuration_id")
  layoutConfiguration   LayoutConfiguration @relation(fields: [layoutConfigurationId], references: [id], onDelete: Cascade)

  componentManifestId String            @map("component_manifest_id")
  componentManifest   ComponentManifest @relation(fields: [componentManifestId], references: [id], onDelete: Cascade)

  contentManifestId String          @map("content_manifest_id")
  contentManifest   ContentManifest @relation(fields: [contentManifestId], references: [id], onDelete: Cascade)

  // Historical versioning, same pattern as every prior M6-M8 output —
  // never overwritten; enforced by the unique constraint below.
  configVersion Int @default(1) @map("config_version")

  // The Website Assembler's own version (which files it generates, how it
  // merges the static template with per-business data) — distinct from
  // contentEngineVersion/componentEngineVersion/layoutEngineVersion/
  // themeVersion, which version its upstream inputs.
  assemblyEngineVersion String @map("assembly_engine_version")

  // {path: string, content: string}[] — the full generated Next.js
  // project, sorted by path for determinism (static-template-loader.ts).
  files Json

  createdAt DateTime @default(now()) @map("created_at")

  websitePreviews         WebsitePreview[]
  previewReports          PreviewReport[]
  publishReadinessReports PublishReadinessReport[]
  WebsiteDeployment       WebsiteDeployment[]

  @@unique([businessId, configVersion])
  @@index([businessId, createdAt])
  @@index([contentManifestId])
  @@map("generated_websites")
}

// Module M9 (DECISIONS.md D-075+) — Website Preview. Read-only: never
// regenerates or modifies GeneratedWebsite (founder's Decision 1). Three
// independent artifacts — WebsitePreview, PreviewReport,
// PublishReadinessReport — each its own model, each its own versioned
// sequence, none FK'd to the others (founder's Decision 1/"all reports
// must be generated independently" — PublishReadinessReport is computed
// from a freshly-run rule list, not by reading a persisted PreviewReport
// row, so it never depends on one existing first). Each carries the same
// metadata envelope (previewVersion/generatedWebsiteVersion/
// validationVersion/generatedByModuleVersion/createdAt) so any one of
// the three is self-describing on its own.
model WebsitePreview {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  generatedWebsiteId String           @map("generated_website_id")
  generatedWebsite   GeneratedWebsite @relation(fields: [generatedWebsiteId], references: [id], onDelete: Cascade)

  previewVersion           Int    @default(1) @map("preview_version")
  generatedWebsiteVersion  Int    @map("generated_website_version")
  validationVersion        String @map("validation_version")
  generatedByModuleVersion String @map("generated_by_module_version")

  businessName  String @map("business_name")
  themeName     String @map("theme_name")
  themeId       String @map("theme_id")
  devicePresets Json   @map("device_presets")
  files         Json

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, previewVersion])
  @@index([businessId, createdAt])
  @@index([generatedWebsiteId])
  @@map("website_previews")
}

model PreviewReport {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  generatedWebsiteId String           @map("generated_website_id")
  generatedWebsite   GeneratedWebsite @relation(fields: [generatedWebsiteId], references: [id], onDelete: Cascade)

  previewVersion           Int    @default(1) @map("preview_version")
  generatedWebsiteVersion  Int    @map("generated_website_version")
  validationVersion        String @map("validation_version")
  generatedByModuleVersion String @map("generated_by_module_version")

  // ValidationRuleResult[] — the flattened output of every registered
  // validator (StructuralValidator/ContentCompletenessValidator/
  // SEOValidator/AccessibilityValidator/PerformanceValidator), each
  // carrying ruleId/ruleCategory/ruleName/severity/status/message/
  // recommendation/documentationUrl (founder's explicit per-rule field
  // requirement).
  rules Json

  validationTimestamp DateTime @map("validation_timestamp")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([businessId, previewVersion])
  @@index([businessId, createdAt])
  @@index([generatedWebsiteId])
  @@map("preview_reports")
}

model PublishReadinessReport {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  generatedWebsiteId String           @map("generated_website_id")
  generatedWebsite   GeneratedWebsite @relation(fields: [generatedWebsiteId], references: [id], onDelete: Cascade)

  previewVersion           Int    @default(1) @map("preview_version")
  generatedWebsiteVersion  Int    @map("generated_website_version")
  validationVersion        String @map("validation_version")
  generatedByModuleVersion String @map("generated_by_module_version")

  // Each a ScoreBreakdown {score, maxScore, deductions[]} — every score
  // explains itself via `deductions` (founder's explicit "must explain
  // why points were deducted" requirement), never a bare number.
  seoScore                 Json @map("seo_score")
  accessibilityScore       Json @map("accessibility_score")
  performanceScore         Json @map("performance_score")
  contentCompletenessScore Json @map("content_completeness_score")
  structuralIntegrityScore Json @map("structural_integrity_score")
  overallPublishScore      Json @map("overall_publish_score")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, previewVersion])
  @@index([businessId, createdAt])
  @@index([generatedWebsiteId])
  @@map("publish_readiness_reports")
}

// Module M11 (DECISIONS.md D-092+) — Deployment Engine. Each row is one
// immutable deployment event, FK'd to `GeneratedWebsite` (M8) directly —
// not the legacy, unused `Website`/`Deployment` scaffold from M2 (D-092).
// Once a row reaches a terminal `status` (COMPLETED/FAILED) it is never
// updated again except for `healthStatus` (D-095, denormalized from the
// latest `DeploymentHealthCheck`) — rollback and retry each create a
// brand-new row (`rollbackFromDeploymentId`/`retryOfDeploymentId`) rather
// than mutating history (founder's explicit Decision 3).
model WebsiteDeployment {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  generatedWebsiteId      String           @map("generated_website_id")
  generatedWebsite        GeneratedWebsite @relation(fields: [generatedWebsiteId], references: [id], onDelete: Cascade)
  generatedWebsiteVersion Int              @map("generated_website_version")

  // Immutable per-business sequence, server-computed (max + 1), same
  // pattern as `SalesProposal.version` (D-085) — never client-supplied,
  // never reused.
  deploymentVersion Int @map("deployment_version")

  provider             DeploymentProviderName
  providerVersion      String                 @map("provider_version")
  // The provider's own opaque deployment id, for status polling —
  // null until the provider actually accepts the deploy call.
  providerDeploymentId String?                @map("provider_deployment_id")

  environment DeploymentEnvironment @default(PRODUCTION)
  commitHash  String?               @map("commit_hash")

  status       DeploymentStatus @default(REQUESTED)
  healthStatus HealthStatus     @default(UNKNOWN) @map("health_status")

  liveUrl      String? @map("live_url")
  errorMessage String? @map("error_message")

  // Content hash of the deployed file set (dedup/integrity signal) and
  // this module's own version — founder's explicit "Additional
  // Requirements" field list.
  deploymentHash          String @map("deployment_hash")
  deploymentEngineVersion String @map("deployment_engine_version")

  // Never a status flag mutated onto a prior row — a rollback/retry is
  // always a fresh row pointing back at what it rolls back/retries
  // (founder's explicit Decision 3: "Rollback is a new deployment event").
  rollbackFromDeploymentId String? @map("rollback_from_deployment_id")
  retryOfDeploymentId      String? @map("retry_of_deployment_id")

  buildStartedAt    DateTime? @map("build_started_at")
  buildCompletedAt  DateTime? @map("build_completed_at")
  completedAt       DateTime? @map("completed_at")
  executionDuration Int?      @map("execution_duration_ms")

  createdById String?     @map("created_by")
  createdBy   TeamMember? @relation("CreatedWebsiteDeployments", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  healthChecks       DeploymentHealthCheck[]
  domainsCurrentlyOn Domain[]                @relation("CurrentDeployment")

  @@unique([businessId, deploymentVersion])
  @@index([businessId, createdAt])
  @@index([generatedWebsiteId])
  @@map("website_deployments")
}

// Module M11 (DECISIONS.md D-095) — Health Check Engine. One row per
// check *run* (not folded into WebsiteDeployment itself) since a
// deployment can be checked repeatedly over its lifetime — automatically
// once right after it completes, and again on demand.
model DeploymentHealthCheck {
  id String @id @default(uuid())

  deploymentId String            @map("deployment_id")
  deployment   WebsiteDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  status         HealthStatus
  checkedAt      DateTime     @map("checked_at")
  responseTimeMs Int?         @map("response_time_ms")
  httpStatusCode Int?         @map("http_status_code")
  // Which specific checks ran and their individual pass/fail — same
  // self-explaining-not-a-bare-verdict discipline as
  // PublishReadinessReport's ScoreBreakdown.deductions (D-080).
  detail         Json?

  @@index([deploymentId, checkedAt])
  @@map("deployment_health_checks")
}

// Module M11 (DECISIONS.md D-096) — Domain Engine. Unlike
// WebsiteDeployment, this is a mutable, long-lived pointer (a hostname
// persists across many deployments going live under it) — closer in kind
// to LeadCRM (D-083) than to SalesProposal's immutable-version rows
// (D-085). Metadata and provider-integration status only — no DNS
// automation, no SSL issuance, no registrar API calls (founder's explicit
// Decision 6).
model Domain {
  id String @id @default(uuid())

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  hostname String                 @unique
  type     DomainType
  provider DeploymentProviderName

  verificationStatus DomainVerificationStatus @default(PENDING) @map("verification_status")
  // The DNS record value a human needs to add at their registrar —
  // provider-returned metadata only, never written anywhere by this
  // module (founder's explicit "do not implement DNS automation").
  verificationRecord Json?                    @map("verification_record")

  sslStatus SslStatus @default(PENDING) @map("ssl_status")

  currentDeploymentId String?            @map("current_deployment_id")
  currentDeployment   WebsiteDeployment? @relation("CurrentDeployment", fields: [currentDeploymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([currentDeploymentId])
  @@map("domains")
}

model Website {
  id          String           @id @default(uuid())
  leadId      String           @map("lead_id")
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      WebsiteGenStatus @default(DRAFT)
  templateKey String           @map("template_key")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  brandKit       BrandKit?
  pages          WebsitePage[]
  generationJobs GenerationJob[]
  deployments    Deployment[]

  @@index([leadId])
  @@index([deletedAt])
  @@map("websites")
}

model BrandKit {
  id           String   @id @default(uuid())
  websiteId    String   @unique @map("website_id")
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  palette      Json
  typography   Json
  logoAssetUrl String?  @map("logo_asset_url")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("brand_kits")
}

model WebsitePage {
  id                 String   @id @default(uuid())
  websiteId          String   @map("website_id")
  website            Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  slug               String
  title              String
  contentBlocks      Json     @map("content_blocks")
  seoMetaTitle       String?  @map("seo_meta_title")
  seoMetaDescription String?  @map("seo_meta_description")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([websiteId, slug])
  @@map("website_pages")
}

model GenerationJob {
  id              String          @id @default(uuid())
  websiteId       String          @map("website_id")
  website         Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  stage           GenerationStage
  status          JobStatus       @default(QUEUED)
  aiUsageMetadata Json?           @map("ai_usage_metadata")
  errorMessage    String?         @map("error_message")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([websiteId, stage])
  @@map("generation_jobs")
}

model Deployment {
  id              String    @id @default(uuid())
  websiteId       String    @map("website_id")
  website         Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  githubRepoUrl   String?   @map("github_repo_url")
  vercelProjectId String?   @map("vercel_project_id")
  liveUrl         String?   @map("live_url")
  status          JobStatus @default(QUEUED)
  deployedAt      DateTime? @map("deployed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([websiteId, deployedAt])
  @@map("deployments")
}

// Module M10 (DECISIONS.md D-085) — Proposal Engine. Extended, not
// replaced, from its original (previously unused by application code)
// M2-era shape. Founder's explicit Decision 7: "Sales Proposals must
// support immutable version history. Never overwrite proposal versions."
// — so each row IS one version: `content`/`version`/`leadId` are set
// once at creation and never updated afterward; only the lifecycle/
// tracking fields (`status`, `sentAt`/`viewedAt`/`acceptedAt`/
// `rejectedAt`) are ever mutated in place, and only on that same row —
// "editing" a proposal means creating a new row with `version + 1`,
// never touching a prior version's content. `content` is nullable
// (renamed from the original required `draftContent`): this module
// tracks proposals, it doesn't draft them (no AI content generation is
// built here — see D-082), so a rep may log "sent v2" purely for
// tracking with the real document living elsewhere.
model SalesProposal {
  id     String @id @default(uuid())
  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  version Int
  content String?
  status  ProposalStatus @default(DRAFT)

  sentAt     DateTime? @map("sent_at")
  viewedAt   DateTime? @map("viewed_at")
  acceptedAt DateTime? @map("accepted_at")
  rejectedAt DateTime? @map("rejected_at")

  createdById String?     @map("created_by")
  createdBy   TeamMember? @relation("CreatedProposals", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([leadId, version])
  @@index([leadId, createdAt])
  @@map("sales_proposals")
}

model CostEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  metadata  Json?
  costUsd   Decimal  @map("cost_usd") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@map("cost_events")
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?     @map("actor_id")
  actor      TeamMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Module M12 (DECISIONS.md D-105) — the Analytics Provider abstraction's
// closed set of pluggable event-tracking targets. Only SELF_HOSTED has a
// concrete provider class this phase (`SelfHostedAnalyticsProvider`,
// founder's explicit Decision 3); the rest are reserved values with no
// adapter behind them yet, the same closed-enum-reservation discipline as
// `DeploymentProviderName` (D-093).
enum AnalyticsProviderName {
  SELF_HOSTED
  POSTHOG
  GOOGLE_ANALYTICS
  MIXPANEL
  AZURE_APPLICATION_INSIGHTS
  DATADOG
}

// Module M12 (DECISIONS.md D-106) — the only table this module owns
// (founder's explicit Decision 4). Raw platform telemetry captured by
// `SelfHostedAnalyticsProvider.track()` — genuinely new data (no other
// module records "Dashboard Viewed"/"Report Generated"-style events),
// never a copy of a fact some other module already persists. Every
// Report/Dashboard/Aggregation computation elsewhere in this module reads
// M1-M11's own tables directly; this table is not an input to any of them.
model AnalyticsEvent {
  id String @id @default(uuid())

  eventType  String  @map("event_type")
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  actorId String?     @map("actor_id")
  actor   TeamMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  provider AnalyticsProviderName @default(SELF_HOSTED)
  metadata Json?

  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@map("analytics_events")
}

