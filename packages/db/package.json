{
  "name": "@riznexia/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, generated client — Doc 06, Doc 18 (Database Architecture).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@riznexia/config-eslint": "workspace:*",
    "@riznexia/config-typescript": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.11.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
