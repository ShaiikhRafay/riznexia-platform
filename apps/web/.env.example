# apps/web environment variables. Copy to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are exposed to the browser — never put a secret behind
# that prefix (Doc 15 §3).

NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# --- Auth (Clerk — Doc 04 §5) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Observability (Doc 16 §13) ---
NEXT_PUBLIC_SENTRY_DSN=""
