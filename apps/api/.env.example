# apps/api environment variables — see docs/16-system-architecture.md and
# docs/04-technical-architecture.md for what each service is for.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (Neon Postgres — Doc 06, Doc 18) ---
# Local dev: point at docker-compose's postgres service, or a Neon dev branch.
DATABASE_URL="postgresql://riznexia:riznexia_dev@localhost:5432/riznexia_dev"

# --- Cache / Rate limiting (Upstash Redis — Doc 16 §10) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Auth (Clerk — Doc 04 §5, Doc 15 §1) ---
CLERK_SECRET_KEY=""
CLERK_JWT_ISSUER=""
CLERK_WEBHOOK_SIGNING_SECRET=""
# Defense-in-depth on top of Clerk's own dashboard sign-up restriction —
# rejects a synced user whose email isn't on this domain (Doc 15 §1).
ALLOWED_EMAIL_DOMAIN="riznexia.com"

# --- AI providers (Doc 09, Doc 16 §7, Doc 20) ---
ANTHROPIC_API_KEY=""
IMAGE_GEN_API_KEY=""          # Recraft or Replicate token (Doc 04 §7)

# --- Lead discovery (Doc 20 Agent 1) ---
GOOGLE_PLACES_API_KEY=""

# --- Deployment pipeline (Doc 20 Agent 9) ---
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_ORG="riznexia-demos"
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_WEBHOOK_SIGNING_SECRET=""

# --- Object storage (Cloudflare R2 — Doc 16 §11) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="riznexia-assets"

# --- Job orchestration (Trigger.dev — Doc 16 §9) ---
TRIGGER_API_KEY=""
TRIGGER_API_URL=""

# --- Observability (Doc 16 §13-14) ---
SENTRY_DSN=""

# --- Cost governance (Doc 04 §10, Doc 20 §1) ---
MONTHLY_COST_CEILING_USD=300
